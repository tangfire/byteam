WEB_PORT=127.0.0.1:18080

MYSQL_DATABASE=byml
MYSQL_USER=byml
MYSQL_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
JWT_SECRET=change-this-long-random-secret

BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP_COUNT=28
BACKUP_INCLUDE_ASSET_ARCHIVES=false

GIT_SYNC_REMOTE=origin
GIT_SYNC_BRANCH=
GIT_SYNC_NAME=BYML Backup Bot
GIT_SYNC_EMAIL=byml-backup@example.local
GIT_SYNC_INTERVAL_SECONDS=21600
GIT_SYNC_ALLOW_UPLOAD_DELETES=false

MAX_UPLOAD_SIZE=104857600
